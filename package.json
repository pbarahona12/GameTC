{
  "name": "ultimate-realistic-tycoon",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "e2e": "playwright test",
    "legal": "vite-node scripts/legal.ts",
    "chaos": "URT_CHAOS_SEEDS=50 URT_CHAOS_YEARS=20 vitest run tests/audit_world.test.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "ota:sign": "node scripts/ota.mjs sign --out ota-dist",
    "ota:verify": "node scripts/ota.mjs verify ota-dist",
    "ota:legacy": "node scripts/ota.mjs legacy",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "nativeCode": 6,
  "otaMinNativeCode": 6
}
